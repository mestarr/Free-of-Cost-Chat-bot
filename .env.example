# Copy this file to .env and paste your key from https://console.groq.com
GROQ_API_KEY=

# Optional: Groq model id (default llama-3.1-8b-instant). Larger models (e.g. llama-3.3-70b-versatile) hit TPM limits faster on free tier — use 8b or lower LLM_MAX_TOKENS if you see rate errors.
# GROQ_MODEL=llama-3.3-70b-versatile

# Groq free/on-demand: each request is capped (~6k tokens for many models) counting prompt + max output + tools.
# Defaults keep you under that: completion cap (Groq only) and automatic prompt trimming. Raise only if your billing tier allows.
# GROQ_MAX_COMPLETION_TOKENS=1536
# GROQ_PER_REQUEST_TOKEN_LIMIT=6000
# GROQ_MAX_TOOL_RESPONSE_CHARS=12000

# Optional: sampling for Groq + Ollama (default temperature 0.35, max output tokens 4096)
# LLM_TEMPERATURE=0.35
# LLM_MAX_TOKENS=4096

# Optional: Groq tool calling (prices, headlines, macro, structured trade card). Default on; set 0 to disable.
# LLM_TOOLS=1
# LLM_MAX_TOOL_ROUNDS=8

# Optional: how often (seconds) the server refreshes prices from CoinGecko (default 10)
# PRICE_CACHE_SECONDS=10

# Optional: RSS headline cache (seconds), max headlines injected into chat
# NEWS_CACHE_SECONDS=300
# NEWS_MAX_HEADLINES_LLM=18

# Optional: shared Redis for price/news read-through cache across workers (omit for in-process memory only).
# Docker Compose (with profile): docker compose --profile cache up -d
# Then set: REDIS_URL=redis://redis:6379/0
# REDIS_URL=
