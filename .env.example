# Copy this file to .env and paste your key from https://console.groq.com
GROQ_API_KEY=

# Optional: Groq model id (default llama-3.1-8b-instant). Larger models (e.g. llama-3.3-70b-versatile) hit TPM limits faster on free tier — use 8b or lower LLM_MAX_TOKENS if you see rate errors.
# GROQ_MODEL=llama-3.3-70b-versatile

# Groq: per-request size + rolling TPM. Defaults favor fewer tokens per call (more messages/minute).
# GROQ_MAX_COMPLETION_TOKENS=2048
# GROQ_PER_REQUEST_TOKEN_LIMIT=6000
# GROQ_MAX_TOOL_RESPONSE_CHARS=9000
# Last N non-system messages sent to Groq (older turns dropped; saves TPD/TPM on long chats).
# GROQ_MAX_CHAT_MESSAGES=4
# Past assistant replies longer than this are tail-truncated before each Groq call.
# GROQ_MAX_ASSISTANT_CHARS=3500

# Optional: sampling for Groq + Ollama (default temperature 0.35, max output tokens 4096)
# LLM_TEMPERATURE=0.35
# LLM_MAX_TOKENS=4096

# Optional: Groq tool calling (prices, headlines, macro, structured trade card). Default on; set 0 to disable.
# LLM_TOOLS=1
# LLM_MAX_TOOL_ROUNDS=8

# Optional: Fear & Greed index cache (seconds); Alternative.me is polled via GET /api/markets/fear-greed
# FNG_CACHE_SECONDS=120

# Optional: how often (seconds) the server refreshes prices from CoinGecko (default 10)
# PRICE_CACHE_SECONDS=10

# Optional: RSS headline cache (seconds), max headlines injected into chat
# NEWS_CACHE_SECONDS=300
# NEWS_MAX_HEADLINES_LLM=12

# Optional: shared Redis for price/news read-through cache across workers (omit for in-process memory only).
# Docker Compose (with profile): docker compose --profile cache up -d
# Then set: REDIS_URL=redis://redis:6379/0
# REDIS_URL=

# --- Per-user API keys, usage, rate limits (SaaS-shaped) ---
# CCP_AUTH_MODE: off (default) | optional | required — API routes under /api/ accept X-CCP-API-Key or Authorization: Bearer.
# CCP_AUTH_MODE=off
# Bootstrap keys: POST /api/admin/keys with header X-CCP-Admin-Secret (set a long random value in prod).
# CCP_ADMIN_SECRET=
# SQLite path for api_keys + usage_daily (default: .data/ccp_accounts.sqlite under project root).
# CCP_ACCOUNTS_DB=
# Pepper for key hashing (change in production; never commit real values).
# CCP_KEY_PEPPER=
# Rate limits: per API key, per anonymous IP (when auth optional/off), window in seconds. With REDIS_URL, limits are shared across workers; otherwise in-process only.
# CCP_RATE_LIMIT_PER_KEY=60
# CCP_RATE_LIMIT_ANON_IP=120
# CCP_RATE_LIMIT_WINDOW_SEC=60

# Optional: Binance futures + flow bundle cache (seconds, default 90)
# ONCHAIN_CACHE_SECONDS=90

# Optional: Whale Alert API key (https://whale-alert.io). When set, the "Whale-scale transfers"
# block in On-chain & flows shows large transfers; when unset, that block stays hidden in the UI.
# WHALE_ALERT_API_KEY=
